<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="view-root" stylesheets="@../scouteo.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.scouteo.controller.HistorialMedicoController">

    <!-- Header oscuro -->
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="view-header">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="HISTORIAL MEDICO" />
            <Label styleClass="page-subtitle" text="Lesiones y seguimiento de recuperacion" />
        </VBox>
        <Label fx:id="lblLesionesActivas" style="-fx-background-color: rgba(198,40,40,0.22); -fx-text-fill: #EF9A9A;                       -fx-font-weight: bold; -fx-font-size: 12px;                       -fx-background-radius: 20; -fx-padding: 4 12 4 12;" text="Lesiones activas: 0" />
        <Button onAction="#abrirFormularioNuevo" styleClass="button-danger" text="+ Nueva lesion" />
    </HBox>

    <!-- Filtros -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
        <Label text="Equipo:" />
        <ComboBox fx:id="cmbEquipo" prefWidth="200" promptText="Seleccionar equipo" />
        <Label text="Jugador:" />
        <TextField fx:id="txtBuscar" prefWidth="180" promptText="Buscar..." />
        <Label text="Estado:" />
        <ComboBox fx:id="cmbEstado" prefWidth="150" promptText="Todos" />
        <Button onAction="#limpiarFiltros" styleClass="button-outline" text="Limpiar" />
    </HBox>

    <!-- Tabla en card -->
    <VBox styleClass="view-card" VBox.vgrow="ALWAYS">
        <padding><Insets bottom="0" left="0" right="0" top="0" /></padding>
        <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colJugador" prefWidth="170" text="Jugador" />
                <TableColumn fx:id="colLesion" prefWidth="148.00003051757812" text="Tipo de Lesion" />
                <TableColumn fx:id="colZona" prefWidth="112.0" text="Zona" />
                <TableColumn fx:id="colFechaLes" prefWidth="103.199951171875" text="Fecha Lesion" />
                <TableColumn fx:id="colFechaRec" prefWidth="108.7999267578125" text="Alta Estimada" />
                <TableColumn fx:id="colDias" maxWidth="70" minWidth="43.20001220703125" prefWidth="55.99993896484375" text="Dias" />
                <TableColumn fx:id="colEstado" prefWidth="100.800048828125" text="Estado" />
                <TableColumn fx:id="colAcciones" prefWidth="152.7999267578125" text="Acciones" />
            </columns>
            <placeholder>
                <Label style="-fx-text-fill: #78909C; -fx-font-size: 14px;" text="No hay registros medicos" />
            </placeholder>
        </TableView>
        <HBox alignment="CENTER_LEFT" styleClass="table-footer">
            <Label fx:id="lblTotal" text="Total: 0 registros" />
        </HBox>
    </VBox>

</VBox>
