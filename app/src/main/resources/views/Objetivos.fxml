<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="view-root" stylesheets="@../scouteo.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javafx.scouteo.controller.ObjetivosController">

    <!-- Header oscuro -->
    <HBox styleClass="view-header" alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="OBJETIVOS" styleClass="page-title"/>
            <Label text="Metas individuales y de equipo" styleClass="page-subtitle"/>
        </VBox>
        <Label text="Equipo:" styleClass="app-bar-label"/>
        <ComboBox fx:id="cmbEquipo" prefWidth="220" promptText="Seleccionar equipo"
                  style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white;
                         -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 4; -fx-background-radius: 4;"/>
        <Button text="+ Nuevo Objetivo" onAction="#abrirFormularioNuevo" styleClass="button-success"/>
    </HBox>

    <!-- Filtros -->
    <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
        <Label text="Estado:" />
        <ComboBox fx:id="cmbEstado" prefWidth="150"/>
        <Label text="Prioridad:" />
        <ComboBox fx:id="cmbPrioridad" prefWidth="120"/>
        <Label text="Tipo:" />
        <ComboBox fx:id="cmbTipo" prefWidth="120"/>
        <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="button-outline"/>
    </HBox>

    <!-- Tabla en card -->
    <VBox styleClass="view-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablaObjetivos" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colTipo"        text="Tipo"         prefWidth="80"/>
                <TableColumn fx:id="colObjetivo"    text="Objetivo"     prefWidth="150"/>
                <TableColumn fx:id="colDescripcion" text="Descripcion"  prefWidth="240"/>
                <TableColumn fx:id="colPrioridad"   text="Prioridad"    prefWidth="90"/>
                <TableColumn fx:id="colEstado"      text="Estado"       prefWidth="110"/>
                <TableColumn fx:id="colProgreso"    text="Progreso"     prefWidth="100"/>
                <TableColumn fx:id="colFechaLimite" text="Fecha Limite" prefWidth="105"/>
                <TableColumn fx:id="colAcciones"    text="Acciones"     prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="No hay objetivos registrados"
                       style="-fx-text-fill: #78909C; -fx-font-size: 14px;"/>
            </placeholder>
        </TableView>
        <HBox styleClass="table-footer" alignment="CENTER_LEFT">
            <Label fx:id="lblTotal" text="Total: 0 objetivos"/>
        </HBox>
    </VBox>
</VBox>
