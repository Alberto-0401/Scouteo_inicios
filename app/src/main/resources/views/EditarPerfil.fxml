<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="view-root" stylesheets="@../scouteo.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javafx.scouteo.controller.EditarPerfilController">

    <!-- Header -->
    <HBox styleClass="view-header" alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="MI PERFIL" styleClass="page-title"/>
            <Label text="Datos personales y seguridad" styleClass="page-subtitle"/>
        </VBox>
        <Button text="Volver" onAction="#volver"
                style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white;
                       -fx-border-color: rgba(255,255,255,0.30); -fx-border-radius: 4;
                       -fx-background-radius: 4; -fx-font-size: 12px; -fx-padding: 6 14;
                       -fx-effect: none;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: #F0F2F5; -fx-background: #F0F2F5; -fx-border-color: transparent;">
        <VBox spacing="16">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!-- Datos personales -->
            <VBox styleClass="form-section" spacing="14">
                <Label text="Datos personales" styleClass="form-section-title"/>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Nombre:" prefWidth="160"
                           style="-fx-text-fill: #546E7A; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtNombre" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Apellidos:" prefWidth="160"
                           style="-fx-text-fill: #546E7A; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtApellidos" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Telefono:" prefWidth="160"
                           style="-fx-text-fill: #546E7A; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtTelefono" HBox.hgrow="ALWAYS" promptText="Opcional"/>
                </HBox>

                <Separator style="-fx-background-color: #E5E9EF;"/>

                <Label text="Cambiar contrasena (dejar en blanco para no cambiarla)"
                       style="-fx-text-fill: #78909C; -fx-font-size: 11px;"/>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Nueva contrasena:" prefWidth="160"
                           style="-fx-text-fill: #546E7A; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="txtPass1" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Repetir contrasena:" prefWidth="160"
                           style="-fx-text-fill: #546E7A; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="txtPass2" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Label fx:id="lblMensaje"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button text="Guardar cambios" onAction="#guardarPerfil"/>
                </HBox>
            </VBox>

            <!-- Zona de peligro -->
            <VBox spacing="10"
                  style="-fx-border-color: #e53935; -fx-border-radius: 6; -fx-background-color: #fff8f8;
                         -fx-background-radius: 6; -fx-padding: 16;">
                <Label text="Zona de peligro"
                       style="-fx-text-fill: #b71c1c; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <Label text="Eliminar tu cuenta es una accion permanente. Se desactivara tu acceso y no podras iniciar sesion."
                       style="-fx-text-fill: #c62828; -fx-font-size: 12px;" wrapText="true"/>
                <HBox>
                    <Button text="Eliminar mi cuenta" onAction="#eliminarCuenta"
                            style="-fx-background-color: #e53935; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 12px;
                                   -fx-padding: 7 16; -fx-background-radius: 4;
                                   -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>

</VBox>
