<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javafx.scouteo.controller.LoginController"
           prefWidth="900" prefHeight="600"
           stylesheets="@../scouteo.css"
           style="-fx-background-color: #1B5E20;">

    <!-- Fondo decorativo izquierdo -->
    <HBox>
        <!-- Panel izquierdo - branding -->
        <VBox styleClass="login-left-panel" prefWidth="420" alignment="CENTER" spacing="20">
            <padding><Insets top="60" right="40" bottom="60" left="40"/></padding>

            <Label text="SCOUTEO" styleClass="login-brand-title"/>
            <Label text="Club Manager" styleClass="login-brand-subtitle"/>
            <Separator style="-fx-background-color: rgba(255,255,255,0.3);"/>
            <Label text="Gestión profesional de&#10;equipos y futbolistas"
                   styleClass="login-brand-desc"
                   textAlignment="CENTER" wrapText="true"/>

            <!-- Decoración estadísticas -->
            <VBox spacing="12" style="-fx-padding: 30 0 0 0;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="✓" styleClass="login-check"/>
                    <Label text="Control multi-equipo por categoría" styleClass="login-feature"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="✓" styleClass="login-check"/>
                    <Label text="Historial médico y lesiones" styleClass="login-feature"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="✓" styleClass="login-check"/>
                    <Label text="Estadísticas y rendimiento" styleClass="login-feature"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="✓" styleClass="login-check"/>
                    <Label text="Gestión de entrenamientos" styleClass="login-feature"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="✓" styleClass="login-check"/>
                    <Label text="Roles: Directiva y Entrenadores" styleClass="login-feature"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Panel derecho - formulario -->
        <VBox styleClass="login-right-panel" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="20">
            <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>

            <Label text="Iniciar Sesion" styleClass="login-form-title"/>
            <Label text="Accede con tu cuenta del club" styleClass="login-form-subtitle"/>

            <VBox spacing="15" style="-fx-padding: 20 0 0 0;">

                <!-- Email -->
                <VBox spacing="5">
                    <Label text="Correo electronico" styleClass="login-field-label"/>
                    <TextField fx:id="txtEmail" promptText="usuario@club.es"
                               styleClass="login-field" prefWidth="320"/>
                </VBox>

                <!-- Contraseña -->
                <VBox spacing="5">
                    <Label text="Contrasena" styleClass="login-field-label"/>
                    <PasswordField fx:id="txtPassword" promptText="••••••••"
                                  styleClass="login-field" prefWidth="320"/>
                </VBox>

                <!-- Error -->
                <Label fx:id="lblError" text="" styleClass="login-error" wrapText="true" maxWidth="320"/>

                <!-- Botón Login -->
                <Button fx:id="btnLogin" text="ENTRAR"
                        onAction="#iniciarSesion"
                        styleClass="login-btn"
                        prefWidth="320" prefHeight="48"
                        defaultButton="true"/>

                <!-- Indicador de carga -->
                <ProgressIndicator fx:id="progressIndicator"
                                   visible="false"
                                   prefWidth="30" prefHeight="30"
                                   style="-fx-progress-color: #2E7D32;"/>

                <!-- Registro -->
                <Button text="Crear cuenta de directiva"
                        onAction="#registrarse"
                        style="-fx-background-color: transparent; -fx-text-fill: #2E7D32; -fx-font-size: 12px; -fx-cursor: hand; -fx-underline: true;"
                        prefWidth="320"/>
            </VBox>

            <Label text="v1.0  •  Club Manager" styleClass="login-version"/>
        </VBox>
    </HBox>
</StackPane>
