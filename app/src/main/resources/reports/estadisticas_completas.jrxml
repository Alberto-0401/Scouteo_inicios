			<element kind="rectangle" uuid="34651b98-a435-4f8f-9d99-0e4846d902b5" mode="Opaque" x="701" y="3" width="101" height="16" backcolor="#FFF3E0" forecolor="#FFF3E0">
				<printWhenExpression><![CDATA["sancionado".equals($F{estado_raw})]]></printWhenExpression>
			</element>
			<element kind="textField" uuid="1d25ceb7-36d1-4906-94cc-55f08466af75" x="701" y="3" width="101" height="16" fontSize="8.5" bold="true" hTextAlign="Center" forecolor="#E65100">
				<printWhenExpression><![CDATA["sancionado".equals($F{estado_raw})]]></printWhenExpression>
				<expression><![CDATA[$F{estado_label}]]></expression>
			</element>
		</band>
