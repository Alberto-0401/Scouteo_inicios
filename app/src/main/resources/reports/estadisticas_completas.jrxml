				<expression><![CDATA[$F{goles_por_partido} != null ? $F{goles_por_partido} : java.math.BigDecimal.ZERO]]></expression>
			</element>
			<!-- Valoracion — color segun nivel -->
			<element kind="textField" uuid="a4aef7d1-e5f8-4f7a-830c-7dbcd63b26cb" x="646" y="3" width="53" height="16" fontSize="9.0" bold="true" hTextAlign="Center" forecolor="#1B5E20" pattern="#0.0">
				<printWhenExpression><![CDATA[$F{prom_valoracion} != null && $F{prom_valoracion}.doubleValue() >= 7.0]]></printWhenExpression>
