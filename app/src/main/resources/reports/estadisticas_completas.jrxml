			<element kind="textField" uuid="3b033add-5fb4-4e1a-b34a-845d0949852b" x="646" y="3" width="53" height="16" fontSize="9.0" hTextAlign="Center" forecolor="#37474F" pattern="#0.0">
				<printWhenExpression><![CDATA[$F{prom_valoracion} != null && $F{prom_valoracion}.doubleValue() >= 5.0 && $F{prom_valoracion}.doubleValue() < 7.0]]></printWhenExpression>
				<expression><![CDATA[$F{prom_valoracion}]]></expression>
			</element>
			<element kind="textField" uuid="7fa8bcb2-d1cc-47ff-9967-207fd27f63fb" x="646" y="3" width="53" height="16" fontSize="9.0" hTextAlign="Center" forecolor="#C62828" pattern="#0.0">
				<printWhenExpression><![CDATA[$F{prom_valoracion} == null || $F{prom_valoracion}.doubleValue() < 5.0]]></printWhenExpression>
				<expression><![CDATA[$F{prom_valoracion} != null ? $F{prom_valoracion} : java.math.BigDecimal.ZERO]]></expression>
			</element>
