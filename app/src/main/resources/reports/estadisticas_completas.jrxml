<jasperReport name="estadisticas_completas" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="11111111-2222-3333-4444-555555555555">
	<parameter name="CLUB_ID" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="TituloInforme" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["Estadisticas Completas de Jugadores"]]></defaultValueExpression>
	</parameter>
	<parameter name="EQUIPO_ID" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
  CONCAT(j.nombre, ' ', j.apellidos) AS jugador,
  e.nombre AS equipo,
  CASE j.posicion
    WHEN 'portero' THEN 'POR'
    WHEN 'defensa_central' THEN 'DC'
    WHEN 'lateral_derecho' THEN 'LD'
    WHEN 'lateral_izquierdo' THEN 'LI'
    WHEN 'mediocentro' THEN 'MC'
    WHEN 'medio_derecho' THEN 'MD'
    WHEN 'medio_izquierdo' THEN 'MI'
    WHEN 'mediapunta' THEN 'MP'
    WHEN 'extremo_derecho' THEN 'ED'
    WHEN 'extremo_izquierdo' THEN 'EI'
    WHEN 'delantero_centro' THEN 'DEL'
    ELSE j.posicion
  END AS posicion_abbr,
  COUNT(a.id) AS partidos_jugados,
  COALESCE(SUM(COALESCE(a.minuto_salida, 90) - COALESCE(a.minuto_entrada, 0)), 0) AS minutos_total,
  COALESCE(SUM(a.goles), 0) AS total_goles,
  COALESCE(SUM(a.asistencias), 0) AS total_asistencias,
  COALESCE(SUM(a.tarjetas_amarillas), 0) AS total_amarillas,
  COALESCE(SUM(a.tarjetas_rojas), 0) AS total_rojas,
  ROUND(COALESCE(SUM(a.goles), 0) / NULLIF(COUNT(a.id), 0), 2) AS goles_por_partido,
  CASE WHEN COUNT(a.id) > 0 THEN ROUND(AVG(COALESCE(a.valoracion, 0)), 1) ELSE 0.0 END AS prom_valoracion,
  j.estado AS estado_raw,
  CASE j.estado WHEN 'lesionado' THEN 'Lesionado' WHEN 'sancionado' THEN 'Sancionado' ELSE 'Activo' END AS estado_label
FROM jugadores j
JOIN equipos e ON j.equipo_id = e.id
LEFT JOIN alineaciones a ON a.jugador_id = j.id
WHERE e.club_id = $P{CLUB_ID} AND j.estado != 'baja'
  AND ($P{EQUIPO_ID} IS NULL OR e.id = $P{EQUIPO_ID})
GROUP BY j.id, j.nombre, j.apellidos, e.nombre, j.posicion, j.estado
ORDER BY e.nombre, total_goles DESC, j.apellidos ASC]]></query>
	<field name="jugador" class="java.lang.String"/>
	<field name="equipo" class="java.lang.String"/>
	<field name="posicion_abbr" class="java.lang.String"/>
	<field name="partidos_jugados" class="java.lang.Long"/>
	<field name="minutos_total" class="java.math.BigDecimal"/>
	<field name="total_goles" class="java.math.BigDecimal"/>
	<field name="total_asistencias" class="java.math.BigDecimal"/>
	<field name="total_amarillas" class="java.math.BigDecimal"/>
	<field name="total_rojas" class="java.math.BigDecimal"/>
	<field name="goles_por_partido" class="java.math.BigDecimal"/>
	<field name="prom_valoracion" class="java.math.BigDecimal"/>
	<field name="estado_raw" class="java.lang.String"/>
	<field name="estado_label" class="java.lang.String"/>
	<variable name="total_jugadores" class="java.lang.Integer" calculation="Count">
		<expression><![CDATA[$F{jugador}]]></expression>
	</variable>
	<variable name="suma_goles" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{total_goles}]]></expression>
	</variable>
	<variable name="suma_asistencias" class="java.math.BigDecimal" calculation="Sum">
		<expression><![CDATA[$F{total_asistencias}]]></expression>
	</variable>
