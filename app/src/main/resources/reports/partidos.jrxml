<jasperReport name="partidos" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="aaaaaaaa-bbbb-cccc-dddd-111111111111">
	<parameter name="CLUB_ID" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="TituloInforme" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["Resultados de la Temporada"]]></defaultValueExpression>
	</parameter>
	<parameter name="EQUIPO_ID" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
  DATE(p.fecha_hora) AS fecha,
  p.rival,
  CASE p.tipo WHEN 'local' THEN 'Local' WHEN 'visitante' THEN 'Visit.' ELSE 'Neutral' END AS tipo_label,
  COALESCE(p.goles_favor, 0) AS goles_favor,
  COALESCE(p.goles_contra, 0) AS goles_contra,
  CASE
    WHEN p.goles_favor > p.goles_contra THEN 'victoria'
    WHEN p.goles_favor = p.goles_contra THEN 'empate'
    WHEN p.goles_favor < p.goles_contra THEN 'derrota'
    ELSE 'empate'
  END AS resultado_raw,
  CASE
    WHEN p.goles_favor > p.goles_contra THEN 'VICTORIA'
    WHEN p.goles_favor = p.goles_contra THEN 'EMPATE'
    WHEN p.goles_favor < p.goles_contra THEN 'DERROTA'
    ELSE '-'
  END AS resultado_label,
  COALESCE(p.posesion_pct, 0) AS posesion,
  COALESCE(p.tiros_a_puerta, 0) AS tiros_puerta,
  COALESCE(p.competicion, '-') AS competicion,
  e.nombre AS equipo,
  e.temporada
FROM partidos p
JOIN equipos e ON p.equipo_id = e.id
WHERE e.club_id = $P{CLUB_ID}
  AND ($P{EQUIPO_ID} IS NULL OR e.id = $P{EQUIPO_ID})
ORDER BY e.nombre, p.fecha_hora DESC]]></query>
	<field name="fecha" class="java.sql.Date"/>
	<field name="rival" class="java.lang.String"/>
	<field name="tipo_label" class="java.lang.String"/>
	<field name="goles_favor" class="java.lang.Integer"/>
	<field name="goles_contra" class="java.lang.Integer"/>
	<field name="resultado_raw" class="java.lang.String"/>
	<field name="resultado_label" class="java.lang.String"/>
