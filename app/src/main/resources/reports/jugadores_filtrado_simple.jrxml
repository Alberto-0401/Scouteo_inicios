<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3 -->
<jasperReport name="jugadores_filtrado_simple" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="edcb6209-fd9d-4614-9084-d57a1b9631db">
	<parameter name="CLUB_ID" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="CONDICION" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="TituloInforme" class="java.lang.String" forPrompting="false">
		<defaultValueExpression><![CDATA["Listado de Jugadores"]]></defaultValueExpression>
	</parameter>
	<parameter name="EQUIPO_ID" class="java.lang.Integer" forPrompting="false">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT
  j.dorsal,
  CONCAT(j.nombre, ' ', j.apellidos) AS jugador,
  CASE j.posicion
    WHEN 'portero' THEN 'Portero'
    WHEN 'defensa_central' THEN 'Def. Central'
    WHEN 'lateral_derecho' THEN 'Lateral Der.'
    WHEN 'lateral_izquierdo' THEN 'Lateral Izq.'
    WHEN 'mediocentro' THEN 'Mediocentro'
    WHEN 'medio_derecho' THEN 'Medio Der.'
    WHEN 'medio_izquierdo' THEN 'Medio Izq.'
    WHEN 'mediapunta' THEN 'Mediapunta'
    WHEN 'extremo_derecho' THEN 'Extremo Der.'
    WHEN 'extremo_izquierdo' THEN 'Extremo Izq.'
    WHEN 'delantero_centro' THEN 'Delantero'
    ELSE j.posicion
  END AS posicion_label,
  TIMESTAMPDIFF(YEAR, j.fecha_nacimiento, CURDATE()) AS edad,
  j.altura_cm,
  CASE j.pierna_dominante WHEN 'derecha' THEN 'Derecha' WHEN 'izquierda' THEN 'Izquierda' ELSE 'Ambidiestro' END AS pie,
  j.estado AS estado_raw,
  CASE j.estado WHEN 'lesionado' THEN 'Lesionado' WHEN 'sancionado' THEN 'Sancionado' ELSE 'Activo' END AS estado_label,
  e.nombre AS equipo,
  CASE e.categoria
    WHEN 'prebenjamin' THEN 'Prebenjamin'
    WHEN 'benjamin' THEN 'Benjamin'
    WHEN 'alevin' THEN 'Alevin'
    WHEN 'infantil' THEN 'Infantil'
    WHEN 'cadete' THEN 'Cadete'
    WHEN 'juvenil' THEN 'Juvenil'
    WHEN 'primer_equipo' THEN 'Primer Equipo'
    WHEN 'senior' THEN 'Senior'
    WHEN 'veteranos' THEN 'Veteranos'
    ELSE e.categoria
  END AS categoria_label,
  e.temporada
FROM jugadores j
JOIN equipos e ON j.equipo_id = e.id
WHERE e.club_id = $P{CLUB_ID}
  AND j.estado != 'baja'
  AND ($P{EQUIPO_ID} IS NULL OR e.id = $P{EQUIPO_ID})
  AND (
    COALESCE($P{CONDICION}, '') = ''
    OR e.categoria = $P{CONDICION}
    OR ($P{CONDICION} = 'POR' AND j.posicion = 'portero')
    OR ($P{CONDICION} = 'DEF' AND j.posicion IN ('defensa_central', 'lateral_derecho', 'lateral_izquierdo'))
    OR ($P{CONDICION} = 'MED' AND j.posicion IN ('mediocentro', 'medio_derecho', 'medio_izquierdo', 'mediapunta'))
    OR ($P{CONDICION} = 'DEL' AND j.posicion IN ('extremo_derecho', 'extremo_izquierdo', 'delantero_centro'))
  )
ORDER BY e.nombre, j.dorsal ASC]]></query>
	<field name="dorsal" class="java.lang.Integer"/>
	<field name="jugador" class="java.lang.String"/>
	<field name="posicion_label" class="java.lang.String"/>
	<field name="edad" class="java.lang.Long"/>
	<field name="altura_cm" class="java.lang.Integer"/>
	<field name="pie" class="java.lang.String"/>
	<field name="estado_raw" class="java.lang.String"/>
	<field name="estado_label" class="java.lang.String"/>
	<field name="equipo" class="java.lang.String"/>
	<field name="categoria_label" class="java.lang.String"/>
	<field name="temporada" class="java.lang.String"/>
	<variable name="total_jugadores" class="java.lang.Integer" calculation="Count">
