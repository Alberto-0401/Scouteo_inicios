	</variable>
	<variable name="lesionados_equipo" class="java.lang.Integer" calculation="Count" resetType="Group" resetGroup="groupEquipo">
		<expression><![CDATA["lesionado".equals($F{estado_raw}) ? 1 : null]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
