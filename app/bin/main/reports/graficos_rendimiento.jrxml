<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="graficos_rendimiento" language="java" pageWidth="595" pageHeight="842"
    columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- === SUBDATASETS primero (el XSD lo exige antes de los parámetros) === -->

    <!-- Subdataset: distribución de jugadores por grupo de posición -->
    <subDataset name="dsPosiciones">
        <parameter name="CLUB_ID" class="java.lang.Integer"/>
        <queryString language="SQL"><![CDATA[
SELECT
  CASE
    WHEN j.posicion = 'portero' THEN 'Porteros'
    WHEN j.posicion IN ('defensa_central','lateral_derecho','lateral_izquierdo') THEN 'Defensas'
    WHEN j.posicion IN ('mediocentro','medio_derecho','medio_izquierdo','mediapunta') THEN 'Medios'
    WHEN j.posicion IN ('extremo_derecho','extremo_izquierdo','delantero_centro') THEN 'Delanteros'
    ELSE 'Otros'
  END AS grupo_posicion,
  COUNT(*) AS total
FROM jugadores j
JOIN equipos e ON j.equipo_id = e.id
WHERE e.club_id = $P{CLUB_ID} AND j.estado != 'baja'
GROUP BY grupo_posicion
ORDER BY total DESC
        ]]></queryString>
        <field name="grupo_posicion" class="java.lang.String"/>
        <field name="total" class="java.lang.Long"/>
    </subDataset>

    <!-- Subdataset: top 10 goleadores y asistentes -->
    <subDataset name="dsGoleadores">
        <parameter name="CLUB_ID" class="java.lang.Integer"/>
        <queryString language="SQL"><![CDATA[
SELECT
  CONCAT(j.nombre, ' ', j.apellidos) AS jugador,
  COALESCE(SUM(a.goles), 0) AS goles,
  COALESCE(SUM(a.asistencias), 0) AS asistencias
FROM jugadores j
JOIN equipos e ON j.equipo_id = e.id
LEFT JOIN alineaciones a ON a.jugador_id = j.id
WHERE e.club_id = $P{CLUB_ID} AND j.estado != 'baja'
GROUP BY j.id, j.nombre, j.apellidos
ORDER BY goles DESC, asistencias DESC
LIMIT 10
        ]]></queryString>
        <field name="jugador" class="java.lang.String"/>
        <field name="goles" class="java.math.BigDecimal"/>
        <field name="asistencias" class="java.math.BigDecimal"/>
    </subDataset>

    <!-- === PARÁMETROS del informe principal === -->
    <parameter name="CLUB_ID" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="TituloInforme" class="java.lang.String">
        <defaultValueExpression><![CDATA["Gráficos de Rendimiento"]]></defaultValueExpression>
    </parameter>

    <!-- Consulta principal mínima: produce 1 fila para renderizar las bandas -->
    <queryString language="SQL"><![CDATA[SELECT 1 AS dummy]]></queryString>
    <field name="dummy" class="java.lang.Integer"/>

    <!-- === CABECERA === -->
    <title>
        <band height="82">
            <rectangle>
                <reportElement x="-20" y="-20" width="635" height="102" mode="Opaque" backcolor="#0D1B2A" forecolor="#0D1B2A"/>
            </rectangle>
            <rectangle>
                <reportElement x="-20" y="78" width="635" height="4" mode="Opaque" backcolor="#C9A84C" forecolor="#C9A84C"/>
            </rectangle>
            <staticText>
                <reportElement x="0" y="10" width="130" height="22" forecolor="#C9A84C"/>
                <textElement><font size="15" isBold="true"/></textElement>
                <text><![CDATA[SCOUTEO]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="34" width="130" height="12" forecolor="#607D8B"/>
                <textElement><font size="8"/></textElement>
                <text><![CDATA[Club Manager]]></text>
            </staticText>
            <line>
                <reportElement x="138" y="10" width="1" height="50" forecolor="#C9A84C"/>
            </line>
            <staticText>
                <reportElement x="148" y="8" width="340" height="30" forecolor="#FFFFFF"/>
                <textElement><font size="17" isBold="true"/></textElement>
                <text><![CDATA[GRÁFICOS DE RENDIMIENTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="148" y="42" width="280" height="14" forecolor="#C9A84C"/>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[Distribución y estadísticas del club]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="448" y="42" width="107" height="14" forecolor="#90A4AE"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- === DETALLE: las dos gráficas (se imprime 1 vez) === -->
    <detail>
        <band height="680">

            <!-- Título sección pie chart -->
            <staticText>
                <reportElement x="0" y="8" width="555" height="16" forecolor="#C9A84C"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[DISTRIBUCIÓN DE JUGADORES POR POSICIÓN]]></text>
            </staticText>

            <!-- PIE CHART -->
            <pieChart>
                <chart>
                    <reportElement x="0" y="28" width="555" height="270"/>
                    <chartTitle position="Top">
                        <titleExpression><![CDATA["Plantilla activa por grupo de posición"]]></titleExpression>
                    </chartTitle>
                    <chartLegend position="Bottom"/>
                </chart>
                <pieDataset>
                    <dataset>
                        <datasetRun subDataset="dsPosiciones">
                            <datasetParameter name="CLUB_ID">
                                <datasetParameterExpression><![CDATA[$P{CLUB_ID}]]></datasetParameterExpression>
                            </datasetParameter>
                        </datasetRun>
                    </dataset>
                    <pieSeries>
                        <keyExpression><![CDATA[$F{grupo_posicion}]]></keyExpression>
                        <valueExpression><![CDATA[$F{total}]]></valueExpression>
                        <labelExpression><![CDATA[$F{grupo_posicion} + " (" + $F{total} + ")"]]></labelExpression>
                    </pieSeries>
                </pieDataset>
                <piePlot>
                    <plot/>
                    <itemLabel/>
                </piePlot>
            </pieChart>

            <!-- Línea separadora -->
            <line>
                <reportElement x="0" y="308" width="555" height="1" forecolor="#C9A84C"/>
            </line>

            <!-- Título sección bar chart -->
            <staticText>
                <reportElement x="0" y="318" width="555" height="16" forecolor="#C9A84C"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[TOP 10 GOLEADORES Y ASISTENTES]]></text>
            </staticText>

            <!-- BAR CHART -->
            <barChart>
                <chart>
                    <reportElement x="0" y="338" width="555" height="330"/>
                    <chartTitle position="Top">
                        <titleExpression><![CDATA["Goles y asistencias — top 10 jugadores"]]></titleExpression>
                    </chartTitle>
                    <chartLegend position="Bottom"/>
                </chart>
                <categoryDataset>
                    <dataset>
                        <datasetRun subDataset="dsGoleadores">
                            <datasetParameter name="CLUB_ID">
                                <datasetParameterExpression><![CDATA[$P{CLUB_ID}]]></datasetParameterExpression>
                            </datasetParameter>
                        </datasetRun>
                    </dataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Goles"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{jugador}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{goles}]]></valueExpression>
                    </categorySeries>
                    <categorySeries>
                        <seriesExpression><![CDATA["Asistencias"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{jugador}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{asistencias}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>
                <barPlot>
                    <plot/>
                    <itemLabel/>
                    <categoryAxisFormat><axisFormat/></categoryAxisFormat>
                    <valueAxisFormat><axisFormat/></valueAxisFormat>
                </barPlot>
            </barChart>

        </band>
    </detail>

    <!-- === PIE DE PÁGINA === -->
    <pageFooter>
        <band height="22">
            <rectangle>
                <reportElement x="-20" y="0" width="635" height="22" mode="Opaque" backcolor="#0D1B2A" forecolor="#0D1B2A"/>
            </rectangle>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="2" y="4" width="180" height="14" forecolor="#607D8B"/>
                <textElement><font size="8.5"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="182" y="4" width="190" height="14" forecolor="#C9A84C"/>
                <textElement textAlignment="Center"><font size="8.5"/></textElement>
                <text><![CDATA[SCOUTEO - Club Manager]]></text>
            </staticText>
            <textField>
                <reportElement x="372" y="4" width="160" height="14" forecolor="#607D8B"/>
                <textElement textAlignment="Right"><font size="8.5"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="532" y="4" width="23" height="14" forecolor="#607D8B"/>
                <textElement><font size="8.5"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
