<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javafx.scouteo.controller.RankingController"
      styleClass="view-root" stylesheets="@../scouteo.css">

    <!-- Header oscuro -->
    <HBox styleClass="view-header" alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="RANKING DE JUGADORES" styleClass="page-title"/>
            <Label text="Clasificacion por rendimiento y estadisticas" styleClass="page-subtitle"/>
        </VBox>
    </HBox>

    <!-- Filtros -->
    <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
        <Label text="Ordenar por:"/>
        <ComboBox fx:id="cmbOrdenar" prefWidth="180">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Goles"/>
                    <String fx:value="Asistencias"/>
                    <String fx:value="Partidos Jugados"/>
                    <String fx:value="Promedio Goles"/>
                </FXCollections>
            </items>
        </ComboBox>
        <Label text="Posicion:"/>
        <ComboBox fx:id="cmbPosicion" prefWidth="120">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Todas"/>
                    <String fx:value="POR"/>
                    <String fx:value="DEF"/>
                    <String fx:value="MED"/>
                    <String fx:value="DEL"/>
                </FXCollections>
            </items>
        </ComboBox>
        <Button fx:id="btnAplicarFiltrosRanking" text="Aplicar filtros"
                onAction="#aplicarFiltros" styleClass="button"/>
    </HBox>

    <!-- Tabla en card -->
    <VBox styleClass="view-card" VBox.vgrow="ALWAYS">
        <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
        <TableView fx:id="tablaRanking" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colPosicion"      text="#"       minWidth="38" maxWidth="50" prefWidth="44"/>
                <TableColumn fx:id="colNombre"         text="Jugador" prefWidth="160"/>
                <TableColumn fx:id="colDorsal"         text="Dor."    minWidth="42" maxWidth="56" prefWidth="48"/>
                <TableColumn fx:id="colPosicionJuego"  text="Pos."    prefWidth="60"/>
                <TableColumn fx:id="colPartidos"       text="Part."   prefWidth="60"/>
                <TableColumn fx:id="colGoles"          text="Goles"   prefWidth="70"/>
                <TableColumn fx:id="colAsistencias"    text="Asist."  prefWidth="70"/>
                <TableColumn fx:id="colPromedio"       text="Prom."   prefWidth="70"/>
            </columns>
        </TableView>
        <HBox styleClass="table-footer" alignment="CENTER_LEFT">
            <Label fx:id="lblTotal" text="Mostrando 0 jugadores"/>
        </HBox>
    </VBox>

</VBox>