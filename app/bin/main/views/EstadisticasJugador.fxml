<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="view-root" stylesheets="@../scouteo.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javafx.scouteo.controller.EstadisticasJugadorController">

    <!-- Header oscuro -->
    <HBox styleClass="view-header" alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="ESTADISTICAS POR JUGADOR" styleClass="page-title"/>
            <Label text="Rendimiento individual partido a partido" styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="btnVolverEstadisticas" text="Volver al listado"
                onAction="#volverDashboard"
                style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white;
                       -fx-border-color: rgba(255,255,255,0.30); -fx-border-radius: 4;
                       -fx-background-radius: 4; -fx-font-size: 12px; -fx-padding: 6 14;
                       -fx-effect: none;"/>
    </HBox>

    <!-- Selector de jugador -->
    <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="12">
        <Label text="Jugador:"/>
        <ComboBox fx:id="cmbJugador" prefWidth="260" promptText="Elige un jugador..."/>
        <Button fx:id="btnCargarEstadisticas" text="Ver estadisticas"
                onAction="#cargarEstadisticas" styleClass="button"/>
    </HBox>

    <!-- Tabla + stats resumen en card -->
    <VBox styleClass="view-card" VBox.vgrow="ALWAYS">
        <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
        <TableView fx:id="tablaEstadisticas" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colFecha"       text="Fecha"    prefWidth="88"/>
                <TableColumn fx:id="colRival"       text="Rival"    prefWidth="140"/>
                <TableColumn fx:id="colResultado"   text="Result."  prefWidth="72"/>
                <TableColumn fx:id="colMinutos"     text="Min."     prefWidth="52"/>
                <TableColumn fx:id="colGoles"       text="Goles"    prefWidth="56"/>
                <TableColumn fx:id="colAsistencias" text="Asist."   prefWidth="56"/>
                <TableColumn fx:id="colTarjetasA"   text="T.A."     prefWidth="50"/>
                <TableColumn fx:id="colTarjetasR"   text="T.R."     prefWidth="50"/>
                <TableColumn fx:id="colAcciones"    text="Acciones" minWidth="130" prefWidth="150"/>
            </columns>
        </TableView>

        <!-- Resumen estadisticas como cards compactos -->
        <HBox styleClass="table-footer" alignment="CENTER" spacing="40">
            <VBox alignment="CENTER" spacing="2">
                <Label fx:id="lblTotalGoles" text="0"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1E2A3B;"/>
                <Label text="Goles totales"
                       style="-fx-font-size: 11px; -fx-text-fill: #78909C;"/>
            </VBox>
            <Separator orientation="VERTICAL" style="-fx-background-color: #E5E9EF;"/>
            <VBox alignment="CENTER" spacing="2">
                <Label fx:id="lblTotalAsistencias" text="0"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1E2A3B;"/>
                <Label text="Asistencias"
                       style="-fx-font-size: 11px; -fx-text-fill: #78909C;"/>
            </VBox>
            <Separator orientation="VERTICAL" style="-fx-background-color: #E5E9EF;"/>
            <VBox alignment="CENTER" spacing="2">
                <Label fx:id="lblPromedioGoles" text="0.0"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1E2A3B;"/>
                <Label text="Promedio goles"
                       style="-fx-font-size: 11px; -fx-text-fill: #78909C;"/>
            </VBox>
        </HBox>
    </VBox>

</VBox>
