{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "gradle-run",
            "type": "shell",
            "command": "./gradlew :app:run",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "gradle-build",
            "type": "shell",
            "command": "./gradlew :app:compileJava",
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$javac"
        }
    ]
}